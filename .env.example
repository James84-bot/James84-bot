# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
# Set to true in production (HTTPS only)
DJANGO_SECURE_COOKIES=false
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_JSON=false
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://jmh:jmh_dev_password@localhost:5432/jmh_ops
# Used by docker compose for the database container
POSTGRES_DB=jmh_ops
POSTGRES_USER=jmh
POSTGRES_PASSWORD=jmh_dev_password

# Console backend prints emails (password reset, invitations) to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=JMH Ops <no-reply@example.com>
# For real email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
